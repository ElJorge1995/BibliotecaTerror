{
  "info": {
    "name": "Librum Tenebris — API completa",
    "description": "Colección de pruebas de los dos backends de Librum Tenebris (TFG FP DAW): ApiLoging (auth/JWT) y libros_api (catálogo y préstamos). Incluye script de login que rellena automáticamente las variables {{jwt}} y {{usuario_id}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "librum-tenebris-tfg-2026"
  },
  "variable": [
    { "key": "auth_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "jwt", "value": "", "type": "string" },
    { "key": "usuario_id", "value": "", "type": "string" },
    { "key": "test_email", "value": "pruebatfgnormal@gmail.com", "type": "string" },
    { "key": "test_password", "value": "Admin123456", "type": "string" }
  ],
  "item": [
    {
      "name": "ApiLoging — Autenticación",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{auth_url}}/auth/register", "host": ["{{auth_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario_demo\",\n  \"email\": \"demo+{{$timestamp}}@example.com\",\n  \"password\": \"DemoPass123\",\n  \"first_name\": \"Demo\",\n  \"last_name\": \"User\",\n  \"dni\": \"00000000T\",\n  \"phone\": \"+34600000000\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (rellena {{jwt}} y {{usuario_id}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('jwt', json.token);",
                  "    console.log('JWT guardado en {{jwt}}');",
                  "}",
                  "if (json.user && json.user.id) {",
                  "    pm.collectionVariables.set('usuario_id', json.user.id);",
                  "    console.log('usuario_id guardado:', json.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{auth_url}}/auth/login", "host": ["{{auth_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{auth_url}}/auth/me", "host": ["{{auth_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{auth_url}}/auth/logout", "host": ["{{auth_url}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "POST /auth/request-password-reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{auth_url}}/auth/request-password-reset", "host": ["{{auth_url}}"], "path": ["auth", "request-password-reset"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/resend-verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{auth_url}}/auth/resend-verification", "host": ["{{auth_url}}"], "path": ["auth", "resend-verification"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\"\n}" }
          }
        }
      ]
    },
